<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.azm.qa</groupId>
  <artifactId>mobile-automation</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AZM Agentic Android Automation Framework</name>
  <description>
    Appium + TestNG Android automation framework for com.titanstudio.pro. Android only --
    no iOS driver exists or is planned in this assignment; see README's Scope section.
    Markdown spec -> deterministic codegen -> runnable tests, backed by a
    deterministic self-healing locator engine. No billed API key anywhere.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Versions per the team's Appium Setup Guide (September 2026 snapshot). -->
    <appium.client.version>10.1.1</appium.client.version>
    <!--
      java-client declares an OPEN-ENDED RANGE for Selenium. Letting Maven resolve
      "whatever is newest on Central today" is how a working build silently breaks:
      a newer Selenium drops a class java-client's compiled bytecode still references,
      and you get a runtime NoSuchMethodError/NoClassDefFoundError rather than a
      compile error. A direct declaration at an exact version wins Maven's dependency
      mediation over the transitive range, which keeps the classpath stable across
      rebuilds. 4.43.0 is the version java-client 10.1.1 is built against.
    -->
    <selenium.version>4.43.0</selenium.version>
    <testng.version>7.10.2</testng.version>
    <allure.version>2.29.0</allure.version>
    <aspectj.version>1.9.22.1</aspectj.version>
    <jackson.version>2.18.1</jackson.version>
    <slf4j.version>2.0.16</slf4j.version>
    <logback.version>1.5.12</logback.version>
    <surefire.version>3.5.2</surefire.version>

    <!-- Override from the CLI: -DsuiteFile=testng-smoke.xml -->
    <suiteFile>testng.xml</suiteFile>
    <allure.results.directory>${project.basedir}/allure-results</allure.results.directory>
  </properties>

  <dependencies>
    <!-- Appium W3C client (Android + iOS). -->
    <dependency>
      <groupId>io.appium</groupId>
      <artifactId>java-client</artifactId>
      <version>${appium.client.version}</version>
    </dependency>

    <!-- Pinned explicitly: see the selenium.version comment above. -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
    </dependency>

    <!-- Reporting -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <version>${allure.version}</version>
    </dependency>

    <!-- Spec parsing, locator repository, heal ledger, run analysis -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>azm-mobile-automation</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${suiteFile}</suiteXmlFile>
          </suiteXmlFiles>
          <!--
            Allure's @Step/@Attachment annotations are woven at runtime by AspectJ.
            Without this javaagent the report still builds, but every test shows as a
            single opaque block with no steps inside it. The javaagent path is quoted because
            a local Maven repository path can contain spaces. allure.results.directory is set
            only via systemPropertyVariables, never repeated in argLine: this project's own
            directory has a space in it ("Mobile Automation"), and an unquoted system property
            value placed directly in argLine splits into multiple JVM arguments right there,
            which surefire then cannot parse back into a valid command line.
          -->
          <argLine>
            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
          </argLine>
          <systemPropertyVariables>
            <allure.results.directory>${allure.results.directory}</allure.results.directory>
          </systemPropertyVariables>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <!--
        The agentic CLI. Every pipeline command runs through PipelineRunner; see CLAUDE.md
        for the full list (md, parse, crawl, impacted, analyze).
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.azm.qa.mobile.cli.PipelineRunner</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <reporting>
    <plugins>
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>2.12.0</version>
        <configuration>
          <reportVersion>${allure.version}</reportVersion>
          <resultsDirectory>${allure.results.directory}</resultsDirectory>
        </configuration>
      </plugin>
    </plugins>
  </reporting>
</project>
