<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast-feedback tier: -Dgroups=smoke. Override with: mvnw test -DsuiteFile=testng-smoke.xml -->
<suite name="AzmMobileSmokeSuite" verbose="1">
    <listeners>
        <listener class-name="com.azm.qa.mobile.listeners.TestListener"/>
    </listeners>
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.azm.qa.mobile.smoke"/>
            <package name="com.azm.qa.mobile.generated"/>
        </packages>
    </test>
</suite>
