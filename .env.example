# Reference list of environment variables ConfigManager honors (system property > env var >
# config-{env}.properties > config.properties). This file is NOT auto-loaded by the framework
# -- it's documentation. Export what you need, e.g.:
#   $env:APP_PATH = "C:\path\to\base.apk"     (PowerShell)
#   export APP_PATH=/path/to/base.apk         (bash)

APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_PACKAGE=com.titanstudio.pro
APP_ACTIVITY=com.titanstudio.pro.MainActivity
APP_PATH=
DEVICE_PROFILE=default
APPIUM_NORESET=false
APPIUM_FULLRESET=false
TEST_RETRYCOUNT=1
ENV=local

# Only ever read by AiNarrator. Every other component in this framework -- self-healing,
# codegen, reporting -- works with this unset. Leave it unset unless you specifically want the
# optional AI-narrated paragraph on top of `mvn exec:java -Dexec.args="analyze"`.
ANTHROPIC_API_KEY=
